static func _lines(entries:Array,goddess:String)->Array:
	var result:Array=[]
	for entry in entries:
		result.append({"who":goddess if entry[0]=="goddess" else entry[0],"text":entry[1]})
	return result
static func _choices(scene:Dictionary,texts:Array,replies:Array,goddess:String)->void:
	for index in mini(scene.get("choices",[]).size(),texts.size()):
		scene.choices[index].text=texts[index]
		scene.choices[index].reply=_lines(replies[index],goddess)
static func apply(original:Dictionary,id:StringName,repeated:bool,goddess:String)->Dictionary:
	var scene:=original.duplicate(true)
	scene.erase("lines_repeat")
	var entries:Array=[]
	match id:
		&"intro_wake":
			scene.title="希希芙 · 跟着小小的声音"
			entries=[
				["","长长的黑发上沾着草叶。希希芙坐在树根旁，循着一声很细的呜咽，望向林子深处。"],
				["player","我本来在找一只受伤的小魔物。然后有一道光……这里是哪里？"],
				["goddess","晶石会学着发出求救声。先别伸手，希希芙。"],
				["player","可是，我听见它害怕。"],
				["goddess","我是伊莉丝。等你找到愿意回答的伙伴，再问它要不要一起走。"],
				["player","找到以后，我们可以一起离开吗？"]]
			if repeated:entries=[["","她数过袖口的线结。小扣和幽灯的名字还在，林间又响起陌生的声音。"],["player","我记得它们。新的声音……这次我会慢一点听。"],["goddess","记住名字，比收紧命令更可靠。欢迎回来，希希芙。"]]
			_choices(scene,["怎么分辨真的求救？","我的影子受伤了吗？","我想先听它说完。","怎样安全离开？","蹲下，等影子自己靠近。"],[
				[["goddess","真正的求救会等你回答。晶石只会催你服从它的方向。"]],
				[["goddess","它借来的是暂时的身体。照顾它，也别忘了照顾自己。"]],
				[["player","我不会追着假的声音跑。但我想知道，它原本在找谁。"]],
				[["goddess","清理房间，确认安全以后再祈祷。我会回应你的呼唤。"]],
				[["","一团影子轻触她的袖角。她没有抓住它，等它自己停下来。"]]],goddess)
		&"intro_weapon":
			scene.title="第一份契约 · 愿意同行吗"
			entries=[["","一具骸灵从草叶间探出头。希希芙扶起地上的木杖，先把手停在它能退开的地方。"],["player","我的名字是希希芙。你愿意和我一起走吗？"],["","骨指敲了两下杖柄。一点紫光沿着木纹亮起。"],["goddess","晶石控制的魔物仍会攻击你。只有愿意回应的灵体，才能成为你的伙伴。"],["player","那么，先告诉我你的名字。"]]
			scene.choices=[{"text":"握住木杖 · 与影灵同行","affinity":0,"flags":{&"start_weapon":"staff"},"give":&"staff_apprentice","reply":_lines([["","她在契约上留下自己的名字，把属于对方的一行空着。"]],goddess),"next":&""}]
		&"death_first":
			scene.title="断开的线 · 伙伴在哪里"
			entries=[["","紫光熄灭，她的手穿过伙伴逐渐散去的轮廓。希希芙还想把它们推到安全的地方。"],["player","你们先走。我……马上就来。"],["","金光接住了她。袍袖上的线结没有断，也没有随影子一起消失。"],["goddess","契约结束了，名字还在。听我的声音，先回来。"]]
		&"death_hall":
			scene.title="契约的另一头"
			entries=[["","回廊里没有骨骼的脚步。希希芙反复数着袖口的结，生怕少了一个。"],["player","我是不是把它们留在里面了？"],["goddess","暂时的身体已经散去。灵体有自己的归处，不是被困在那里。"],["player","我还没问过，它们下次想不想回来。"],["goddess","下次见面时再问。现在，先把你自己的线解开。"]]
			_choices(scene,["契约结束后，它们去哪里？","我害怕它们受伤。","我不想用命令叫它们回来。","怎样保护仍在同行的伙伴？","轻轻念出每个伙伴的名字。"],[
				[["goddess","各自选择能去的地方。契约应当是一条路，不能是一把锁。"]],
				[["goddess","你一直照顾它们。下次也留一点生命和魔力给自己。"]],
				[["player","如果它们不愿意，我就换一条路，去认识新的伙伴。"]],
				[["goddess","及时召回，可以照顾仍在同行的伙伴；已经结束的契约，需要重新呼唤。"]],
				[["","每念出一个名字，她就碰一下线结。掌心里的金光慢慢安静下来。"]]],goddess)
		&"death_hall_intro":
			scene.title="等候的人 · 可以先坐一会儿"
			entries=[["","希希芙挪开长袍，替女神留出一点石阶。她没有马上问下一次出发。"],["player","一直在这里等，会不会很累？"],["goddess","我不能陪你走过每个房间，但会记得你回来时的声音。"],["player","那我也记住你。不会让你一个人等到忘记名字。"],["goddess","好。先坐一会儿，再出发。"]]
		&"death_reenter":
			scene.title="重新出发 · 再问一次"
			entries=[["","光的边缘传来两声轻敲。希希芙抬起手，却没有立刻打开契约。"],["player","今天也愿意同行吗？不是因为纸上的名字，是你自己的意思。"],["","幽灯照亮了她的杖尖，小扣轻轻点头。"],["goddess","安全的时候再呼唤我。你不用替所有声音走完所有路。"]]
		_:
			if str(id).begins_with("cp_"):
				var chapter:=int(str(id).trim_prefix("cp_"))
				if CHAPTER.has(chapter):scene.title=CHAPTER[chapter][0];entries=CHAPTER[chapter][1]
				if chapter==100:_choices(scene,["继续寻找走散的声音。","带着伙伴的名字，先回去。"],[
					[["player","还有谁没有找到愿意听的人。我想再走一段。"],["goddess","我在出口等你。别再让一张契约替别人决定。"]],
					[["","她把线结拢在掌心，向女神伸出手。每个名字都在，却没有一道锁链。"],["goddess","回去以后，也会有人愿意听你的声音。"]]],goddess)
	if not entries.is_empty():scene.lines=_lines(entries,goddess)
	return scene
static func death_line(goddess:String)->Array:
	var pool:=["线结还在。等你不再害怕，我们再问它们愿不愿意同行。","你给它们留了一条路。现在也给自己留一点休息的时间。","小扣已经回答了。它没有怪你。","你不用独自接住所有求救。你也可以来问我。"]
	return [{"who":goddess,"text":pool[Rng.stream().randi_range(0,pool.size()-1)]}]
