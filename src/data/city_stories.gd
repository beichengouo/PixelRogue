    "伊露雅看过两次碎片的位置，就不想再看第三次。真的风会带走灰尘，也会把昨天摆好的东西吹歪。她突然想回廊那扇总关不严的窗，决定回去以后少嫌它漏一点风。",
    "她不喜欢别人替自己登记，更不喜欢把长戟当作解释。可塞芙菈确实在努力提醒她躲开。伊露雅把话说得短一些，好让对方听清：她会打断门印，不会站在原地和失控的武器讲道理。",
    "伊露雅把箭收回去，没有趁对方低头时再追问一串问题。能自己修正方向的人，先得有一点喘气的余地。她也准备停下检查弓弦，省得下一次又被提醒不要什么都留到断了才说。",
    "她先看见了晶纹的拐角，再听见维蕾娜的声音。这两件事对得上，就够她决定先帮眼前的人。剩下谁写错了什么，等手腕能自由放下，再让对方坐着一条条讲。",
    "伊露雅摸了摸副本的纸边，确认够干，才将它收好。她不想听一场没完没了的自责，也不想听轻易的“都过去了”。把错处留下，允许改正，已经是今天可以真的完成的一步。",
    "那段旧记录里也许有回故乡的路，她当然想看。可回廊里的约定不只是一串新记录：窗边给她留着的位置，她已经愿意自己走回去。伊露雅不打算为了别人保证不了的过去，把这条路先擦掉。",
    "她走到出口边，先看了一眼如今朝向城外的箭头。终于是个不用再解释的方向了。伊露雅拍掉袍角灰尘，想起你大概会问她有没有按时喝水，便在回去前把壶里剩下的水喝完。",
    "伊露雅把椅子拉到你身边，先问是不是又空着肚子等大家讲完。过去还有许多空白，她不急着把每格都填满。今天回来后能一起吃饭，明天也能按自己的意思出门，这已经够她先安心坐一会儿。"
  ]
}
const HERO_EXPRESSIONS := ["neutral","thoughtful","thoughtful","determined","neutral","determined","neutral","determined","happy","happy"]
static func scene(id:StringName,repeated:=false,character_id:StringName=&"")->Dictionary:
	var index:=IDS.find(id)
	if index<0:return {}
	var character:Dictionary=Characters.DATA.get(character_id,Characters.current())
	var profile:=str(character.id)
	if not HERO.has(profile):profile="sylphiette"
	var pose:="controlled" if index==5 else "regret" if index in [2,6] else "doubt" if index in [1,3] else "relief" if index>=8 else "calm"
	var entries:Array=[]
	if repeated:
		entries=[{"who":"","text":"她回到回廊，和你补充核对星城记录；先前的关系选择仍然有效。" if index==9 else str(character.name)+"再次调查失名星城的残存记录。先前获释的人没有重新受困，她也记得之前的旅途；这次继续核对尚未查清的线索。"}]
	else:
		entries.append({"who":"","text":FACTS[index][0]})
		var speaker:="塞芙菈" if index in [3,4] else "无名录仪" if index==7 else Story.GODDESS if index==9 else "维蕾娜"
		var expression:="sad" if index in [2,5,6] else "happy" if index in [4,8,9] else "neutral"
		entries.append({"who":speaker,"text":FACTS[index][1],"expression":expression,"portrait":ROOT+pose+".png" if speaker=="维蕾娜" else ""})
		# Tactical goals are narration, not an omnipresent contractor or goddess voice.
		entries.append({"who":"","text":FACTS[index][2]})
	if not repeated:entries.append({"who":"","text":HERO_THOUGHTS[profile][index]})
	entries.append({"who":str(character.name),"text":HERO[profile][index],"expression":HERO_EXPRESSIONS[index]})
	var choices:Array=[]
	if index in [0,2,6,8]:
		var topic:={0:"城门和书馆的路线",2:"那些重复街景里的旧线索",6:"原件上没署名的改动",8:"这趟带回去的东西"}
		var question:String={"xixifu":"我想听听你的意见。关于%s，你更想让我先讲清最在意的细节，还是按我刚才的打算继续？","sylphiette":"可以听听你的想法吗？关于%s，你想先听我最在意的细节，还是让我按现在的判断继续？","ilyua":"关于%s，你想先听哪处让我最在意，还是让我先照自己的判断走下去？"}[profile]%topic[index]
		var prompt:={"who":str(character.name),"text":question,"expression":"thoughtful"}
		entries.append(prompt)
		var answers:Dictionary={"xixifu":["好，那我先从让我紧张的地方讲。小灵的事也算线索，不能漏掉。","嗯，我按刚才想好的来。遇到不确定的，再找安全的地方问你。"],"sylphiette":["那我不只挑有用的讲。我自己在想什么，也慢慢说给你听。","好。我会先顾好自己，再做眼前这一件事，不把所有问题都扛起来。"],"ilyua":["行。我说具体一点，你听完再想，不用急着替我找答案。","知道。我自己看路，回来把做过的事讲清楚。"]}
		choices=[{"text":"我想先听你最在意的细节。","reply":[{"who":str(character.name),"text":answers[profile][0],"expression":"neutral"}],"next":&""},{"text":"我相信你的判断，先照你的打算做。","reply":[{"who":str(character.name),"text":answers[profile][1],"expression":"neutral"}],"next":&""}]
	return {"narrative_revision":ContractorNarrative.REVISION,"title":"第二章 · "+TITLES[index],"portrait":"","lines":entries,"choices":choices,"next":&""}
