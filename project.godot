; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rondo at Starlight’s End"
config/description="轮舞于星辉尽头 · 俯视房间探索与星辉肉鸽"
config/version="0.45"
run/main_scene="res://src/main/game_shell.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/PixelRogue"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui_art/application/goddess_head_v01.png"

[autoload]

UIFlow="*res://src/autoload/ui_flow.gd"
TransitionLayer="*res://src/autoload/transition_layer.gd"
EventBus="*res://src/autoload/event_bus.gd"
AudioManager="*res://src/autoload/audio_manager.gd"
Rng="*res://src/autoload/rng_service.gd"
SaveService="*res://src/autoload/save_service.gd"
GameState="*res://src/autoload/game_state.gd"
StoryState="*res://src/autoload/story_state.gd"
Outpost="*res://src/autoload/outpost.gd"
AchievementTracker="*res://src/autoload/achievement_tracker.gd"
MobileControls="*res://src/autoload/mobile_controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/pixelrogue_map_tools/plugin.cfg")

[gui]

theme/custom="res://assets/fonts/game_theme.tres"

